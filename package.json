{
  "name": "gateio-futures-trading-bot",
  "version": "2.0.0",
  "description": "Gate.io Futures Trading Bot with WebSocket real-time streaming",
  "main": "trading-bot.js",
  "type": "module",
  "scripts": {
    "start": "node trading-bot.js",
    "scalping": "node trading-bot.js scalping BTC_USDT",
    "breakout": "node trading-bot.js breakout BTC_USDT",
    "grid": "node trading-bot.js grid BTC_USDT",
    "multi": "node trading-bot.js scalping BTC_USDT ETH_USDT",
    "server": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs gateio-trading-bot"
  },
  "keywords": [
    "cryptocurrency",
    "trading",
    "bot",
    "futures",
    "leverage",
    "gate.io",
    "websocket",
    "scalping",
    "breakout",
    "grid-trading"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ccxt": "^4.5.24",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
