# Gate.io API Configuration
GATE_API_KEY=your_api_key_here
GATE_API_SECRET=your_api_secret_here
USE_TESTNET=true

# Trading Configuration
LEVERAGE=10
POSITION_SIZE=10
TRAILING_CALLBACK=0.02
MAX_DAILY_LOSS=5

# Legacy Server Configuration (optional)
EXCHANGE=gateio
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
TRADING_PAIR=BTC/USDT
RISK_PERCENTAGE=2
STRATEGY=Combined
TIMEFRAME=5m

# Server Settings (for web dashboard)
PORT=3000
NODE_ENV=production
FRONTEND_URL=*

# Database
DB_PATH=./data/trading.db
