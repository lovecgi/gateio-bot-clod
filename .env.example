# Gate.io API (테스트넷)
EXCHANGE=gateio
API_KEY=your_testnet_api_key
API_SECRET=your_testnet_api_secret
USE_TESTNET=true

# 거래 설정
TRADING_PAIR=BTC/USDT
LEVERAGE=10
POSITION_SIZE=100
RISK_PERCENTAGE=2
STRATEGY=Combined
TIMEFRAME=5m

# 서버 설정
PORT=3000
NODE_ENV=production
FRONTEND_URL=*

# 데이터베이스
DB_PATH=./data/trading.db
